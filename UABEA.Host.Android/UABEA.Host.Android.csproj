<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android31.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.g5j.uabeahost</ApplicationId>
    <ApplicationTitle>UABEA Original</ApplicationTitle>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <Version>0.2.0</Version>
    <ApplicationVersion>2</ApplicationVersion>
    <AndroidMinSdkVersion>31</AndroidMinSdkVersion>
    <SupportedOSPlatformVersion>31.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <InvariantGlobalization>false</InvariantGlobalization>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>
  </PropertyGroup>
  <ItemGroup>
    <AndroidAsset Include="Assets/uabea-original.tar.gz" Link="uabea-original.tar.gz" />
    <AndroidAsset Include="Assets/linux-x64-rootfs.tar.gz" Link="linux-x64-rootfs.tar.gz" />
    <AndroidNativeLibrary Include="runtimes/android-arm64/native/libproot.so"
                          Abi="arm64-v8a"
                          Condition="Exists('runtimes/android-arm64/native/libproot.so')" />
    <AndroidNativeLibrary Include="runtimes/android-arm64/native/libloader.so"
                          Abi="arm64-v8a"
                          Condition="Exists('runtimes/android-arm64/native/libloader.so')" />
    <AndroidNativeLibrary Include="runtimes/android-arm64/native/libbox64.so"
                          Abi="arm64-v8a"
                          Condition="Exists('runtimes/android-arm64/native/libbox64.so')" />
  </ItemGroup>
</Project>
