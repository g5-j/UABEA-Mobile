<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android31.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.g5j.uabeahost</ApplicationId>
    <ApplicationTitle>UABEA Original</ApplicationTitle>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <Version>0.1.0</Version>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidMinSdkVersion>31</AndroidMinSdkVersion>
    <SupportedOSPlatformVersion>31.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <InvariantGlobalization>false</InvariantGlobalization>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <AndroidAsset Include="Assets/uabea-original.tar.gz" Link="uabea-original.tar.gz" />
  </ItemGroup>
</Project>
