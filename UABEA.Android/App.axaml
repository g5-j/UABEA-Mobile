<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="UABEA.Mobile.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <SimpleTheme />
    <materialIcons:MaterialIconStyles />

    <!-- Consistent, modern dark surfaces and soft interaction feedback. -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="BorderBrush" Value="#2B3B50" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Opacity" Value="0.93" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Opacity" Value="0.76" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.42" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="#151F2C" />
      <Setter Property="Foreground" Value="#F3F7FC" />
      <Setter Property="BorderBrush" Value="#2B3B50" />
      <Setter Property="CaretBrush" Value="#83B9FF" />
      <Setter Property="SelectionBrush" Value="#36577D" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="#151F2C" />
      <Setter Property="Foreground" Value="#F3F7FC" />
      <Setter Property="BorderBrush" Value="#2B3B50" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ComboBox /template/ Border">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="#151F2C" />
      <Setter Property="BorderBrush" Value="#2B3B50" />
    </Style>
    <Style Selector="ComboBoxItem /template/ Border">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="#151F2C" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Background" Value="#151F2C" />
      <Setter Property="Foreground" Value="#F3F7FC" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Background" Value="#202D3D" />
      <Setter Property="Foreground" Value="#F3F7FC" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="#29415D" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="#151F2C" />
      <Setter Property="Foreground" Value="#F3F7FC" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Background" Value="#151F2C" />
      <Setter Property="Foreground" Value="#F3F7FC" />
    </Style>
    <Style Selector="MenuItem:pointerover">
      <Setter Property="Background" Value="#202D3D" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="#101722" />
      <Setter Property="Foreground" Value="#64758B" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
      <Setter Property="Background" Value="#64758B" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
      <Setter Property="Background" Value="#83B9FF" />
    </Style>
  </Application.Styles>
</Application>
